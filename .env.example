# Copy to .env (git-ignored) and fill in. Never commit real values.
# Windows: copy .env.example .env

# Required. Comma-separated SHA-256 hashes of valid API keys.
# Generate a key + hash with:  python -m api.auth
TRUTHLAYER_API_KEY_HASHES=

# Required when running the API directly (uvicorn). PostgreSQL 15 URL for
# request usage logs (REQ-14). Ignored by Docker Compose, which builds the URL
# from the POSTGRES_* values below and points it at the "db" container.
# TRUTHLAYER_DATABASE_URL=postgresql+psycopg://truthlayer:<password>@localhost:5432/truthlayer
TRUTHLAYER_DATABASE_URL=

# Docker Compose only: the PostgreSQL container's credentials.
# POSTGRES_PASSWORD is required. Use letters, digits, '-' and '_' only, since it
# is embedded in a URL. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_USER=truthlayer
POSTGRES_DB=truthlayer
# Host port for the database (5433 avoids clashing with a local PostgreSQL).
POSTGRES_HOST_PORT=5433

# Optional (defaults shown).
TRUTHLAYER_LOG_RETENTION_DAYS=30
TRUTHLAYER_KNOWLEDGE_BASE_ID=wikipedia_subset
TRUTHLAYER_KNOWLEDGE_BASE_PATH=knowledge_base.json
TRUTHLAYER_CORS_ORIGINS=http://localhost:3000
